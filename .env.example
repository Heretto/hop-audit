# HOP Audit settings. One file for local runs (./dev.sh) and docker compose.
# ./dev.sh creates .env from this template with generated secrets.

APP_ENV=development
APP_DEBUG=false

# Relative to backend/ for local runs; compose overrides it with a volume path.
DATABASE_URL=sqlite:///./data/audit.db

# Generate each with: openssl rand -hex 32
APP_SECRET_KEY=
JWT_SECRET_KEY=
# Encrypts stored model keys. It cannot be rotated: changing or losing it
# makes every saved credential unreadable. Back it up; never regenerate it.
ENCRYPTION_KEY=

FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# Production should use SSO only; see hop-core AGENTS.md §11 before enabling.
#SSO_ONLY=true
#GOOGLE_OAUTH_CLIENT_ID=
#MICROSOFT_OAUTH_CLIENT_ID=
#MICROSOFT_OAUTH_CLIENT_SECRET=
#MICROSOFT_OAUTH_TENANT_ID=
#ALLOWED_EMAIL_DOMAINS=heretto.com
