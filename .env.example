# HOP Audit settings. One file for local runs (./dev.sh) and docker compose.
# ./dev.sh creates .env from this template with generated secrets.

APP_ENV=development
APP_DEBUG=false

# Relative to backend/ for local runs; compose overrides it with a volume path.
DATABASE_URL=sqlite:///./data/audit.db

# Generate each with: openssl rand -hex 32
APP_SECRET_KEY=
JWT_SECRET_KEY=
# Encrypts stored model keys. It cannot be rotated: changing or losing it
# makes every saved credential unreadable. Back it up; never regenerate it.
ENCRYPTION_KEY=

# Local runs (./dev.sh sets both to its own port).
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# docker compose only: the app's public origin, used in place of the two
# above (and for SSO redirects). This is the shared VM's value, exactly; for
# docker compose on your machine use http://localhost:8080.
PUBLIC_URL=https://audit.herettoopenprojects.ai
# Leave COOKIE_DOMAIN unset: cookies stay on their own host.

# Who can sign up. The VM is on the public internet: set at least
# ALLOWED_EMAIL_DOMAINS there, and SINGLE_ORG_MODE so the team shares one
# organization (the first person to sign up becomes its admin).
#ALLOWED_EMAIL_DOMAINS=heretto.com
#SINGLE_ORG_MODE=true
#SINGLE_ORG_SLUG=heretto
#SINGLE_ORG_NAME=Heretto

# Production should use SSO only; see hop-core AGENTS.md §11 before enabling.
#SSO_ONLY=true
#GOOGLE_OAUTH_CLIENT_ID=
#MICROSOFT_OAUTH_CLIENT_ID=
#MICROSOFT_OAUTH_CLIENT_SECRET=
#MICROSOFT_OAUTH_TENANT_ID=
